{
  "name": "robins-colors",
  "productName": "Robin's Colors",
  "version": "0.5.0",
  "description": "Robin's Colors",
  "author": "HaitoDann",
  "main": "main.cjs",
  "scripts": {
    "copy": "rm -rf game && cp -r ../dist game",
    "exe": "cd .. && npm run build && cd desktop && npm run copy && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.haitodann.robinscolors",
    "files": ["main.cjs", "game/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "RobinsColors.exe" }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
